# Cultural Inclusive Story Generation — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── LLM / VLM Provider ───────────────────────────────────────────────────────
# Google Gemini API key (get free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API key (for alternative LLM provider)
OPENAI_API_KEY=your_openai_api_key_here

# ─── Model Configuration ──────────────────────────────────────────────────────
# VLM model name (default: gemini-3.8-flash)
VLM_MODEL=gemini-3.8-flash

# LLM model name for story generation (default: gemini-3.8-flash)
LLM_MODEL=gemini-3.8-flash

# Embedding model (default: all-MiniLM-L6-v2, runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Retrieval Configuration ──────────────────────────────────────────────────
# Vector store backend: chromadb | faiss
VECTOR_STORE=chromadb

# Number of top-k cultural records to retrieve (default: 5)
RETRIEVAL_TOP_K=5

# ─── Story Generation ─────────────────────────────────────────────────────────
# Target story length in words (default: 400)
STORY_TARGET_WORDS=400

# Reading level: general | simple | academic (default: general)
STORY_READING_LEVEL=general

# ─── Application Mode ─────────────────────────────────────────────────────────
# Set to "live" for real Gemini image analysis and story generation
# Set to "mock" only for automated tests or offline development
APP_MODE=live

# ─── Paths ────────────────────────────────────────────────────────────────────
KB_RAW_PATH=data/raw/sample_kb.jsonl
KB_PROCESSED_PATH=data/processed
CHROMA_DB_PATH=data/processed/chroma_db
EXPERIMENTS_PATH=experiments/results

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
